# ===== 本地配置模板（提交入库；真实配置 ingress.yaml 已在 .gitignore 忽略）=====
# 用法：cp ingress.yaml.sample ingress.yaml，替换 CHANGE_ME_* 占位符。
# Ingress 的配置同样不展开 ${VAR}，凭据必须直接写成值。

# 连接 LiveKit 的凭据（与 livekit.yaml 的 keys 一致）
api_key: CHANGE_ME_LIVEKIT_KEY
api_secret: CHANGE_ME_LIVEKIT_SECRET
ws_url: ws://127.0.0.1:7880

redis:
  address: 127.0.0.1:6379

logging:
  level: info

rtc_config:
  udp_port: 7885
  use_external_ip: true
